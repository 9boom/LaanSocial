# ==============================================================================
# LaanSocial - Environment Configuration Template (.env.example)
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Port for HTTP & WebSocket server (Default: 80)
PORT=80

# MongoDB Connection URI (e.g., mongodb://127.0.0.1:27017 or mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017

# Database Name (Default: LaanDBDevelopment)
DB_NAME=LaanDBDevelopment

# ------------------------------------------------------------------------------
# 2. DATABASE COLLECTIONS
# ------------------------------------------------------------------------------
USERS_COLLECTION=users
UNIVERSITIES_COLLECTION=universities
SUBROOM_UNI_COLLECTION=subroom_uni
SUBROOM_TEMP_VOTES_COLLECTION=subroom_temp_votes
PUBLIC_CHAT_COLLECTION=public_chat
IN_CHAT_REPORT_COLLECTION=in_chat_report
UNIVERSITIES_REQUEST_COLLECTION=universities_request
LOGS_COLLECTION=LOGS

# ------------------------------------------------------------------------------
# 3. LOGGING & RETENTION
# ------------------------------------------------------------------------------
# Number of days to retain logs in database (Default: 90)
LOG_RETENTION_DAYS=90

# Batch size for log queue before flushing to database (Default: 50)
LOG_QUEUE_BATCH_SIZE=50

# Log queue flush interval in milliseconds (Default: 3000)
LOG_QUEUE_FLUSH_INTERVAL_MS=3000

# ------------------------------------------------------------------------------
# 4. STORAGE & DIRECTORY PATHS
# Relative paths are resolved relative to the project root directory.
# Absolute paths are also supported.
# ------------------------------------------------------------------------------
UNIVERSITY_LOGOS_DIR=public/assets/sim_db/universities_logos
USER_PROFILE_IMAGES_DIR=public/assets/sim_db/users_profile_image
CHAT_ATTACHMENT_DIR=public/assets/sim_db/users_chat_attachment

# URL prefixes for serving uploaded assets
PROFILE_IMAGE_URL_PREFIX=assets/sim_db/users_profile_image/
CHAT_ATTACHMENT_URL_PREFIX=assets/sim_db/users_chat_attachment/

# ------------------------------------------------------------------------------
# 5. FILE UPLOADS & ATTACHMENTS
# ------------------------------------------------------------------------------
# Allowed extensions for profile/logo images (comma-separated)
IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.webp,.svg

# Allowed extensions for chat attachments (comma-separated)
ATTACHMENT_EXTENSIONS=.png,.jpg,.jpeg,.webp,.gif,.pdf

# Allowed MIME types for chat attachments (comma-separated)
ATTACHMENT_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf

# Maximum attachment size in megabytes (Default: 5)
MAX_ATTACHMENT_SIZE_MB=5

# Maximum body parser payload size (Default: 256kb)
BODY_PARSER_LIMIT=256kb

# Retention TTL for pending (unused) uploaded attachments in milliseconds (Default: 600000 = 10 mins)
PENDING_ATTACHMENT_TTL_MS=600000

# Cleanup interval for pending attachments in milliseconds (Default: 60000 = 1 min)
PENDING_ATTACHMENT_CLEANUP_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# 6. CHAT & SUBROOMS
# ------------------------------------------------------------------------------
# Maximum character length for chat messages (Default: 200)
MAX_MESSAGE_LENGTH=200

# Maximum message history stored/kept per subroom (Default: 200)
MAX_SUBROOM_CHAT_MESSAGES=200

# Number of messages loaded per page (Default: 10)
MESSAGE_PAGE_SIZE=10

# Allowed subroom types (comma-separated, Default: official,community,temp)
SUBROOM_TYPES=official,community,temp

# Allowed expiration days for temporary subrooms (comma-separated numbers, Default: 1,3,7,14,30)
ALLOWED_EXPIRE_DAYS=1,3,7,14,30

# Required vote count for temporary subrooms (Default: 15)
SUBROOM_TEMP_VOTE_TOTAL=15

# ------------------------------------------------------------------------------
# 7. REALTIME & WEBSOCKET
# ------------------------------------------------------------------------------
# Presence TTL in milliseconds (Default: 120000 = 2 mins)
PRESENCE_TTL_MS=120000

# Joined ping interval / presence cleanup interval in milliseconds (Default: 60000 = 1 min)
JOINED_PING_MS=60000

# WebSocket authentication timeout in milliseconds (Default: 10000 = 10 secs)
WS_AUTH_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 8. RATE LIMITING
# ------------------------------------------------------------------------------
# API rate limit window in milliseconds (Default: 60000 = 1 min)
API_RATE_LIMIT_WINDOW_MS=60000

# Maximum API requests per window (Default: 60)
API_RATE_LIMIT_MAX=60

# WebSocket message rate limit window in milliseconds (Default: 60000 = 1 min)
WS_RATE_LIMIT_WINDOW_MS=60000

# Maximum WebSocket messages per window (Default: 30)
WS_RATE_LIMIT_MAX=30

# Cleanup interval for in-memory rate limiter maps in milliseconds (Default: 60000 = 1 min)
RATE_LIMITER_CLEANUP_INTERVAL_MS=60000
